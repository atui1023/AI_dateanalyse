# AI 数据分析系统配置示例
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交

# ========== 模型 API ==========
API_KEY=your_api_key_here
BASE_URL=https://your-llm-endpoint/v1
MODEL=qwen-plus
# remote：调用兼容 OpenAI 的在线向量接口；local：本机运行 SentenceTransformers
EMBEDDING_PROVIDER=remote
EMBEDDING_MODEL=text-embedding-v3
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=cpu
# 留空时按 provider/model 自动隔离集合；旧远程模型会继续使用 kb_store
CHROMA_COLLECTION=

# ========== 数据库配置 ==========
# 默认使用 SQLite；生产环境可替换为下方 MySQL 连接串
DATABASE_URL=sqlite:///./data_analysis.db

# MySQL 可选配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aidataanalysis
DB_USER=aidata
DB_PASSWORD=your_strong_password_here
# SQLAlchemy MySQL 连接串示例（密码中的 @ 等字符需 URL 编码）
# DATABASE_URL=mysql+pymysql://aidata:your_password_url_encoded@127.0.0.1:3306/aidataanalysis?charset=utf8mb4

# ========== 安全配置 ==========
SESSION_SECRET=replace_with_a_random_32_byte_secret
ADMIN_PASSWORD=replace_with_a_strong_password

# ========== 生产部署 ==========
# 可挂载到独立磁盘或对象存储同步目录；默认使用项目下的 uploads
STORAGE_DIR=./uploads
# 单 IP 每分钟非静态接口请求上限
RATE_LIMIT_PER_MINUTE=120

# ========== 定时报表通知 ==========
# 配置后可发送真实 SMTP 邮件；未配置时会保留模拟发送记录
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ========== 分析沙箱 ==========
# 单次分析最长执行时间和内存上限；可按机器配置调整
ANALYSIS_TIMEOUT_SECONDS=30
ANALYSIS_MEMORY_LIMIT_MB=1536
