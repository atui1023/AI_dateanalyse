# AI 数据分析系统配置示例
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交

# ========== 模型 API ==========
API_KEY=your_api_key_here
BASE_URL=https://your-llm-endpoint/v1
MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# ========== 数据库配置 ==========
# 默认使用 SQLite；生产环境可替换为下方 MySQL 连接串
DATABASE_URL=sqlite:///./data_analysis.db

# MySQL 可选配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aidataanalysis
DB_USER=aidata
DB_PASSWORD=your_strong_password_here
# SQLAlchemy MySQL 连接串示例（密码中的 @ 等字符需 URL 编码）
# DATABASE_URL=mysql+pymysql://aidata:your_password_url_encoded@127.0.0.1:3306/aidataanalysis?charset=utf8mb4

# ========== 安全配置 ==========
SESSION_SECRET=replace_with_a_random_32_byte_secret
ADMIN_PASSWORD=replace_with_a_strong_password

# ========== 分析沙箱 ==========
# 单次分析最长执行时间和内存上限；可按机器配置调整
ANALYSIS_TIMEOUT_SECONDS=30
ANALYSIS_MEMORY_LIMIT_MB=1536
